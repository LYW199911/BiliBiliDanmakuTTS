{
  "manifest_version": 3,
  "name": "BiliDanmakuTTS - 息屏听弹幕助手",
  "version": "1.0.0",
  "description": "专为闭眼听视频、通勤听弹幕打造！智能过滤水弹幕、高频梗折叠、自动音频压限（Ducking）与真人级语音播报。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BiliDanmakuTTS 控制面板"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/bangumi/play/*"
      ],
      "js": [
        "core/slang-dict.js",
        "core/scheduler.js",
        "core/tts-engine.js",
        "core/danmaku-provider.js",
        "ui/floating-panel.js",
        "content.js"
      ],
      "css": [
        "ui/floating-panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
