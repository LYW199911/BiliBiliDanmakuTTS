{
  "manifest_version": 3,
  "name": "BiliDanmakuTTS - 息屏听弹幕助手",
  "version": "1.0.3",
  "description": "专为闭眼听视频、通勤听弹幕打造！智能过滤水弹幕、高频梗折叠、自动音频压限（Ducking）与真人级语音播报。",
  "permissions": [],
  "host_permissions": [
    "*://*.bilibili.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BiliDanmakuTTS - 息屏听弹幕助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/video/*",
        "*://www.bilibili.com/list/*",
        "*://www.bilibili.com/bangumi/play/*"
      ],
      "js": [
        "core/slang-dict.js",
        "core/scheduler.js",
        "core/tts-engine.js",
        "core/danmaku-provider.js",
        "ui/floating-panel.js",
        "content.js"
      ],
      "css": [
        "ui/floating-panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
